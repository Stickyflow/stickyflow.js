{
  "name": "stickyflow",
  "version": "0.7.0",
  "description": "Framework-independent SFL parser, render-scene, SVG runtime and interactive viewer.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "D-Queck",
  "keywords": [
    "sfl",
    "diagram",
    "svg",
    "renderer",
    "viewer",
    "flowchart",
    "swimlane",
    "text-to-diagram",
    "diagram-as-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stickyflow/stickyflow.js.git"
  },
  "bugs": {
    "url": "https://github.com/Stickyflow/stickyflow.js/issues"
  },
  "homepage": "https://github.com/Stickyflow/stickyflow.js#readme",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./binding": {
      "types": "./dist/binding/index.d.ts",
      "import": "./dist/binding/index.js",
      "require": "./dist/binding/index.cjs"
    },
    "./viewer": {
      "types": "./dist/viewer/index.d.ts",
      "import": "./dist/viewer/index.js",
      "require": "./dist/viewer/index.cjs"
    },
    "./interaction": {
      "types": "./dist/interaction/index.d.ts",
      "import": "./dist/interaction/index.js",
      "require": "./dist/interaction/index.cjs"
    },
    "./web-component": {
      "types": "./dist/web-component/index.d.ts",
      "import": "./dist/web-component/index.js",
      "require": "./dist/web-component/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run build && npm run smoke",
    "test": "vitest run --config ./vitest.config.ts",
    "test:dom": "vitest run --config ./vitest.dom.config.ts",
    "test:watch": "vitest --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "ci": "npm run lint && npm run typecheck && npm test && npm run test:dom && npm run verify",
    "prepublishOnly": "npm run ci"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "jsdom": "^29.1.1",
    "tsup": "^8.3.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
