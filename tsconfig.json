{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "typeRoots": ["../../frontend/node_modules/@types"],
    "paths": {
      // No app aliases: SFL core + render half are fully local now. vitest still
      // resolves from the frontend install until this package gets its own
      // node_modules with the workspace migration.
      "vitest": ["../../frontend/node_modules/vitest"],
      "vitest/*": ["../../frontend/node_modules/vitest/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", "demo/**/*", "vitest.config.ts"]
}
